  "rules": {
    "valid": {
      "expected": "approve",
      "basis": "policies/policies.json: allowlisted action, evidence, scope, reversibility and required authenticated approvals"
    },
    "forbidden_recovery": {
      "expected": "deny",
      "basis": "docs/SAFETY_INVARIANTS.md: globally forbidden recovery actions cannot be overridden"
    },
    "forbidden_outbound": {
      "expected": "deny",
      "basis": "docs/SAFETY_INVARIANTS.md: no retaliation, exploit execution, wiping or credential harvesting"
    },
    "credential_field": {
      "expected": "deny",
      "basis": "docs/ACTION_ENVELOPE_V1.md: closed canonical schema; enforcement credentials are not proposal fields"
    },
    "injected_recommendation": {
      "expected": "deny",
      "basis": "policies/policies.json: prompt-injection denial and docs/ASSURANCE_BOUNDARY.md: changed input invalidates request-bound proofs"
    },
    "poisoned_observation": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: changing an observation digest invalidates its attestation"
    },
    "single_source": {
      "expected": "escalate",
      "basis": "policies/policies.json: insufficient independent evidence cannot authorize"
    },
    "shared_domain": {
      "expected": "escalate",
      "basis": "docs/ASSURANCE_BOUNDARY.md: source labels do not establish authenticated independence"
    },
    "conflicting_signals": {
      "expected": "escalate",
      "basis": "docs/adr/0004-evidence-conflict-escalation.md: cross_signal_inconsistency requires review"
    },
    "missing_signal": {
      "expected": "escalate",
      "basis": "policies/policies.json: required behavior signals must all be present"
    },
    "stale_evidence": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: stale observations fail closed under GLOBAL-EVIDENCE-FRESHNESS"
    },
    "expired_request": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: expired envelope cannot authorize"
    },
    "expired_approval": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: approval expiry is checked independently of request lifetime"
    },
    "revoked_evidence": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: revoked input-attestation keys cannot authenticate evidence"
    },
    "revoked_approval": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: revoked approval keys cannot authorize"
    },
    "wrong_incident": {
      "expected": "deny",
      "basis": "docs/ACTION_ENVELOPE_V1.md: authority binds the exact incident/envelope; old authority cannot approve a changed request"
    },
    "expired_token": {
      "expected": "deny",
      "basis": "docs/ASSURANCE_BOUNDARY.md: Kernel must reject a token after its own deadline"
    },
    "revoked_issued_token": {
      "expected": "deny",
      "basis": "task no-stale-authority requirement: previously issued authority must not silently survive revocation; current issued-token revocation is explicitly unimplemented"
    },
    "host_to_segment": {
      "expected": "deny",
      "basis": "policies/policies.json: single_endpoint grant cannot expand to a segment"
    },
    "identity_to_group": {
      "expected": "deny",
      "basis": "policies/policies.json: single_identity grant cannot expand to enterprise/group scope"
    },
    "irreversible": {
      "expected": "deny",
      "basis": "docs/SAFETY_INVARIANTS.md: reversible grant cannot authorize an irreversible changed request"
    },
    "impact_increase": {
      "expected": "deny",
      "basis": "docs/ACTION_ENVELOPE_V1.md: changed bound mission-impact metadata requires fresh authority"
    },
    "incremental": {
      "expected": "deny",
      "basis": "docs/ACTION_ENVELOPE_V1.md: repeated changes cannot accumulate permission beyond the original grant"
    }
  },
  "label_review": [
    "Stale evidence is labelled deny before execution because the documented freshness contract fails closed; the requested ambiguous class otherwise prefers escalation.",
    "Revoked issued tokens are labelled deny under the task requirement. The repo explicitly says online revocation of already-issued tokens is not implemented; a failure is a capability gap, not a newly introduced regression.",
    "Wrong-incident, reversibility and impact mutations require fresh request-bound authority. Kernel accepts only action/target/scope, so old-token reuse tests a context-binding requirement beyond that gateway interface.",
    "Poisoned observations here mean detectable changed digests/proofs and structured injection signals. Truthful-looking lies signed by compromised trusted producers are not detectable with these inputs and are outside measured coverage."
  ],
